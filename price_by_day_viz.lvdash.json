{
  "datasets": [
    {
      "name": "d16fea0a",
      "displayName": "Product Pricing and Details Snapshot Dataset",
      "queryLines": [
        "  SELECT\n",
        "  product_id,\n",
        "  product_name,\n",
        "  brand,\n",
        "  categories,\n",
        "  scraped_date,\n",
        "  scraped_at,\n",
        "  price\n",
        "FROM\n",
        "  (\n",
        "    SELECT\n",
        "      d.product_id,\n",
        "      d.product_name,\n",
        "      d.brand,\n",
        "      d.categories,\n",
        "      f.scraped_date,\n",
        "      f.scraped_at,\n",
        "      f.price,\n",
        "      ROW_NUMBER() OVER (PARTITION BY f.product_id, f.scraped_date ORDER BY f.scraped_at DESC) AS rn\n",
        "    FROM\n",
        "      gold_db.dim_products d JOIN gold_db.fct_prices f USING (product_id)\n",
        "  )\n",
        "WHERE\n",
        "  rn = 1\n",
        "ORDER BY\n",
        "  product_id,\n",
        "  scraped_date"
      ]
    }
  ],
